extends Node

func _ready() -> void:
	run.call_deferred()

func run() -> void:
	SaveManager.save_path = "user://kuih_menu_test.json"
	SaveManager.reset()
	assert(SaveManager.get_setting("language") == "en")
	assert(SaveManager._normalize({"settings": {"language": "ms"}, "coins": 490})["settings"]["language"] == "en")
	assert(SaveManager._normalize({"language_policy": 2, "settings": {"language": "ms"}})["settings"]["language"] == "ms")
	SaveManager.data["profile"]["name"] = "Tester"
	SaveManager.set_setting("language", "en")
	assert(SaveManager.save_game())
	SaveManager.load_game()
	assert(SaveManager.data["profile"]["name"] == "Tester")
	assert(MenuText.text("play") == "Play")
	assert(SaveManager._normalize({"settings": {"language": true}})["settings"]["language"] == "en")
	assert(SaveManager._normalize({"profile": {"name": 123}})["profile"]["name"] == "Player")
	SaveManager.data["levels"] = {"1": {"stars": 3}, "2": {"stars": 3}, "3": {"stars": 3}, "4": {"stars": 3}}
	var home := HomeScreen.new()
	add_child(home)
	await get_tree().process_frame
	assert(home._profile_label.text == "Tester")
	assert(home._level_label.text == "Lv 2")
	assert(home.get_node("RecipesButton") != null)
	assert(home.get_node("JourneyButton") != null)
	assert(home._star_label.text == "12")
	assert(home.get_node("StarCounter") != null)
	assert(SaveManager._normalize({"diamonds": -20})["diamonds"] == 0)
	SaveManager.data["diamonds"] = 7
	assert(SaveManager.save_game())
	SaveManager.load_game()
	assert(EconomyManager.diamonds() == 7)
	home._refresh()
	assert(home._star_label.text == "12")
	assert(home._progress.value == 2)
	assert(home._total_score_label.text == "Score 0")
	ProgressionManager.record_win(1, 3, 0, 1234)
	assert(home._total_score_label.text == "Score 1234")
	home._show_records()
	assert(home.get_node("MenuPopup") != null)
	home.get_node("MenuPopup").free()
	assert(ResourceLoader.exists(SceneManager.ACHIEVEMENTS))
	var achievement_screen: Control = load(SceneManager.ACHIEVEMENTS).instantiate()
	add_child(achievement_screen)
	await get_tree().process_frame
	assert(achievement_screen._content.get_child_count() > 0)
	achievement_screen.free()
	home.free()
	var map := JourneyMap.new()
	add_child(map)
	await get_tree().process_frame
	assert(map.stop_progress(JourneyMap.ROUTE[0])["cleared"] == 4)
	assert(map.stop_progress(JourneyMap.ROUTE[0])["stars"] == 12)
	assert(map.stop_progress(JourneyMap.ROUTE[0])["total"] == 10)
	assert(map._node_state(JourneyMap.ROUTE[0]) == "open")
	assert(map.memories_for(JourneyMap.ROUTE[0]).is_empty())
	ProgressionManager.mark_story_seen(&"beat_01_open")
	ProgressionManager.mark_story_read(StoryLibrary.PROLOGUE)
	var memories := map.memories_for(JourneyMap.ROUTE[0])
	assert(memories.size() == 2)
	assert(map.memories_for(JourneyMap.ROUTE[1]).is_empty())
	map._show_stop(JourneyMap.ROUTE[0])
	assert(map.get_node("StopPopup") != null)
	map._replay_memory(memories[1])
	assert(map.get_node("MemoryReplay").customer_name == "Pakyai")
	assert(not ProgressionManager.story_seen(&"beat_04_tapau"))
	map.free()
	var settings := SettingsScreen.new()
	add_child(settings)
	var language := settings.find_child("LanguageSelector", true, false) as OptionButton
	language.item_selected.emit(0)
	await get_tree().process_frame
	assert(MenuText.text("play") == "Main")
	var name_input := settings.find_child("PlayerName", true, false) as LineEdit
	name_input.text_changed.emit("Aina Fan")
	assert(SaveManager.data["profile"]["name"] == "Aina Fan")
	settings._show_avatars()
	assert(settings.get_node("AvatarPicker") != null)
	assert(settings.find_child("Avatar_meiling", true, false) != null)
	settings._select_avatar("meiling")
	await get_tree().process_frame
	SaveManager.load_game()
	assert(SaveManager.data["profile"]["avatar"] == "meiling")
	assert(SaveManager._normalize({"profile": {"avatar": "missing"}})["profile"]["avatar"] == "aina")
	settings.free()
	var selected_home := HomeScreen.new()
	add_child(selected_home)
	await get_tree().process_frame
	assert(selected_home._avatar.texture == AvatarLibrary.portrait("meiling"))
	assert(GameManager.next_play_target().has("tutorial"))
	selected_home.free()
	var reset_settings := SettingsScreen.new()
	add_child(reset_settings)
	var music_toggle := reset_settings.find_child("Toggle_music", true, false) as SettingsToggle
	assert(music_toggle != null and music_toggle.toggle_mode)
	music_toggle.button_pressed = false
	assert(SaveManager.get_setting("music", true) == false)
	assert(SaveManager.save_game())
	SaveManager.load_game()
	assert(SaveManager.get_setting("music", true) == false)
	var progress_before := ProgressionManager.total_stars()
	reset_settings._on_reset()
	reset_settings._on_reset()
	assert(reset_settings.has_node("ResetConfirmation"))
	assert(ProgressionManager.total_stars() == progress_before)
	reset_settings.find_child("CancelReset", true, false).pressed.emit()
	await get_tree().process_frame
	assert(not reset_settings.has_node("ResetConfirmation"))
	assert(ProgressionManager.total_stars() == progress_before)
	reset_settings._on_reset()
	reset_settings.find_child("ConfirmReset", true, false).pressed.emit()
	await get_tree().process_frame
	assert(not reset_settings.has_node("ResetConfirmation"))
	assert(ProgressionManager.total_stars() == 0)
	assert(reset_settings.find_child("PlayerName", true, false).text == "Player")
	SaveManager.load_game()
	assert(ProgressionManager.total_stars() == 0)
	reset_settings.free()
	print("PASS menu profile persistence, localization, star progression and popups")
	get_tree().quit()
